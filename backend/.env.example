# Copia este archivo como backend/.env (está en .gitignore; NUNCA lo subas a git)

# --- LLM (OpenAI) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2000
# Para modelos de razonamiento (gpt-5-mini, o4-mini): low reduce latencia y costo
OPENAI_REASONING_EFFORT=low

# --- Negocio ---
IDENTITY_MIN_CONFIDENCE=0.8

# --- Infra / seguridad ---
DATABASE_PATH=onboarding.db
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=30

# --- Auth (login) ---
# Genera el hash con: python -m app.core.auth hash "<contraseña>"
AUTH_USERNAME=evaluador
AUTH_PASSWORD_HASH=pbkdf2_sha256:600000:<salt>:<hash>
AUTH_TOKEN_SECRET=<token aleatorio largo: python -c "import secrets;print(secrets.token_urlsafe(48))">
AUTH_TOKEN_TTL_MINUTES=480
