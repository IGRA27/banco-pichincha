# Copia este archivo como backend/.env (está en .gitignore; NUNCA lo subas a git)

# --- LLM (OpenAI) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=400

# --- Negocio ---
IDENTITY_MIN_CONFIDENCE=0.8

# --- Infra / seguridad ---
DATABASE_PATH=onboarding.db
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=30
